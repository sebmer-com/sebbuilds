{
  "name": "seb-builds-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.5.1",
  "bin": {
    "seb-builds": "./packages/cli/bin/seb-builds.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "astro preview",
