---
import HostedByOhmyhost from "@/components/HostedByOhmyhost.astro";
import { socialImage } from "@/lib/brand";
import { siteConfig } from "@/lib/site";
import type { Metadata } from "@/lib/metadata";
import "@/styles/site.css";
interface Props { metadata?: Metadata; }
const { metadata = {} } = Astro.props;
const title = metadata.title ? `${metadata.title} — ${siteConfig.name}` : "Seb Builds — Products in Public";
const description = metadata.description ?? siteConfig.description;
const canonicalUrl = new URL(metadata.alternates?.canonical ?? Astro.url.pathname, siteConfig.url);
if (!canonicalUrl.pathname.endsWith("/") && !canonicalUrl.pathname.split("/").pop()?.includes(".")) canonicalUrl.pathname += "/";
const canonical = canonicalUrl.href;
const image = metadata.openGraph?.images?.[0] ?? socialImage;
const imageUrl = new URL(typeof image === "string" ? image : image.url, siteConfig.url).href;
const imageAlt = typeof image === "string" ? title : image.alt ?? title;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="color-scheme" content="dark light"/>
    <title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
    {metadata.robots?.index === false && <meta name="robots" content="noindex"/>}
    <meta name="author" content={siteConfig.author.name}/><meta name="creator" content={siteConfig.author.name}/><meta name="publisher" content={siteConfig.name}/>
    <meta name="google-site-verification" content="exxq0qapJW7-X7l0FS_77Tv9bi5NxvcGWidMZQAUK24"/>
    <link rel="alternate" type="application/rss+xml" href="/rss.xml"/><link rel="icon" href="/icon.svg" type="image/svg+xml"/>
    <meta property="og:type" content={metadata.openGraph?.type ?? "website"}/><meta property="og:site_name" content={siteConfig.name}/><meta property="og:locale" content={siteConfig.locale}/>
    <meta property="og:title" content={metadata.openGraph?.title ?? title}/><meta property="og:description" content={metadata.openGraph?.description ?? description}/><meta property="og:url" content={canonical}/>
    <meta property="og:image" content={imageUrl}/><meta property="og:image:alt" content={imageAlt}/>
    {typeof image !== "string" && image.width && <meta property="og:image:width" content={String(image.width)}/>}
    {typeof image !== "string" && image.height && <meta property="og:image:height" content={String(image.height)}/>}
    {metadata.openGraph?.publishedTime && <meta property="article:published_time" content={metadata.openGraph.publishedTime}/>}
    {metadata.openGraph?.tags?.map(tag => <meta property="article:tag" content={tag}/>)}
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={metadata.twitter?.title ?? title}/><meta name="twitter:description" content={metadata.twitter?.description ?? description}/><meta name="twitter:image" content={imageUrl}/><meta name="twitter:image:alt" content={imageAlt}/>
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="publication-root"><slot/><HostedByOhmyhost /></body>
</html>
