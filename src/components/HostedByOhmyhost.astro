---
import styles from "./hosted-by-ohmyhost.module.css";
---
<details class={styles.flag} data-hosting-flag>
  <summary class={styles.toggle}>
    <svg aria-hidden="true" class={styles.omega} fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="12.5" viewBox="0 0 100 100"><path d="M30 87 H14 L27 63 A31 31 0 1 1 73 63 L86 87 H70" /></svg>
    <span aria-hidden="true" class={styles.close}>&gt;</span>
    <span class={`${styles.label} ${styles.showLabel}`}>Show hosting information</span>
    <span class={`${styles.label} ${styles.hideLabel}`}>Close hosting information</span>
  </summary>
  <a class={styles.link} href="https://ohmyho.st/?r=ref-01m3acd03m6jevgydfgg3t0j9q" rel="sponsored noopener" target="_blank"><span>Runs on <span class={styles.domain}>ohmyho.st</span></span></a>
</details>
